# ──────────────────────────────────────────────────────
# Base de données (Supabase PostgreSQL)
# Récupère l'URL dans : Supabase > Settings > Database > Connection string > URI
# ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# ──────────────────────────────────────────────────────
# JWT — génère des secrets aléatoires (min 32 chars)
# Exemple : openssl rand -base64 48
# ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-min-32-chars-random-secret"
JWT_REFRESH_SECRET="change-me-min-32-chars-other-secret"

# ──────────────────────────────────────────────────────
# URLs
# ──────────────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
PORT=4000
NODE_ENV=development

# ──────────────────────────────────────────────────────
# Supabase Storage (pour les logos / fichiers)
# Récupère ces valeurs dans : Supabase > Settings > API
# ──────────────────────────────────────────────────────
SUPABASE_URL="https://[PROJECT_REF].supabase.co"
SUPABASE_SERVICE_KEY="your-supabase-service-role-key"

# ──────────────────────────────────────────────────────
# Email — Resend (https://resend.com, gratuit jusqu'à 3000 emails/mois)
# ──────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ──────────────────────────────────────────────────────
# Compte admin initial (créé au premier démarrage)
# ──────────────────────────────────────────────────────
ADMIN_EMAIL="admin@monentreprise.fr"
ADMIN_PASSWORD="motdepasse-securise"
ADMIN_FIRST_NAME="Admin"
ADMIN_LAST_NAME="Devis"

# ──────────────────────────────────────────────────────
# Firebase (optionnel — notifications push mobiles)
# ──────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=""
# FIREBASE_PRIVATE_KEY=""
# FIREBASE_CLIENT_EMAIL=""
